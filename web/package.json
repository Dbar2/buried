{
  "name": "buried-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Buried web shell: the Evidence Library (spec 01) and the Explorer shell (spec 03).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:studio": "VITE_STUDIO_SERVICE_URL=/ npm run build && playwright test -c playwright.studio.config.ts",
    "test:e2e:landuse": "VITE_STUDIO_SERVICE_URL=/ npm run build && playwright test -c playwright.landuse.config.ts",
    "typecheck": "tsc --noEmit",
    "size": "tsx scripts/sizeReport.ts",
    "gen:types": "tsx scripts/genTypes.ts",
    "gen:bridge-types": "tsx scripts/genBridgeTypes.ts",
    "gen:bridge-samples": "tsx scripts/genBridgeSamples.ts",
    "gen:social-card": "tsx scripts/renderSocialCard.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^3.23.0",
    "json-schema-to-typescript": "^15.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "jsts": "^2.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
