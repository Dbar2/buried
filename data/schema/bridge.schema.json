{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buried.invalid/schema/bridge.schema.json",
  "title": "Buried bridge messages",
  "description": "Every message between the web shell and the Unity Player, bridge version 0.7.0 (the gate subset plus the look pass additions, the drape clip and scene/addFeatures of .kiro/specs/03-explorer; 0.5.0 adds scene/focusLot, scene/clearLot, scene/setDrapeMode, the optional sceneFeature.storeys and the optional drape.kind of session 023; 0.6.0 adds scene/setLantern and scene/showEvidence of session 028 and drops the lamp from the pinned lot; 0.7.0 adds land_use as a sceneFeature kind, session 034). A message is { type, payload }. All positions are EPSG:26917 metres, easting first. No property is named like a year or a date: the Player draws what it is told and never dates anything. Rules JSON Schema cannot express are checked by both parsers (web/src/bridge/bridge.ts and unity/Assets/Buried/Runtime/Bridge/BridgeParser.cs) and covered by the same invalid fixtures: every polygon ring is closed (first position equals last); scene/init eras have unique ids and indexes that are exactly 0 to n-1; scene/init initialView has minE < maxE and minN < maxN and lies inside bounds; scene/init present building ids, scene/loadEra and scene/addFeatures feature ids, scene/loadEra drape source ids and debug/markers ids are each unique; scene/showEvidence carries a drape when on is true and none when it is false. Every change to this file changes the bridge version.",
  "$ref": "#/$defs/bridgeMessage",
  "$defs": {
    "bridgeMessage": {
      "description": "The Envelope: exactly one of the message definitions below.",
      "oneOf": [
        { "$ref": "#/$defs/sceneInitMessage" },
        { "$ref": "#/$defs/sceneLoadEraMessage" },
        { "$ref": "#/$defs/sceneAddFeaturesMessage" },
        { "$ref": "#/$defs/sceneSetDepthMessage" },
        { "$ref": "#/$defs/sceneFocusLotMessage" },
        { "$ref": "#/$defs/sceneClearLotMessage" },
        { "$ref": "#/$defs/sceneSetDrapeModeMessage" },
        { "$ref": "#/$defs/sceneSetLanternMessage" },
        { "$ref": "#/$defs/sceneShowEvidenceMessage" },
        { "$ref": "#/$defs/debugMarkersMessage" },
        { "$ref": "#/$defs/debugSetCameraMessage" },
        { "$ref": "#/$defs/readyMessage" },
        { "$ref": "#/$defs/eraLoadedMessage" },
        { "$ref": "#/$defs/featureClickedMessage" },
        { "$ref": "#/$defs/cameraChangedMessage" },
        { "$ref": "#/$defs/errorMessage" }
      ]
    },

    "sceneInitMessage": {
      "description": "Shell to Player. Always the first message.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "scene/init" },
        "payload": { "$ref": "#/$defs/sceneInitPayload" }
      }
    },
    "sceneLoadEraMessage": {
      "description": "Shell to Player. Replaces one era's content.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "scene/loadEra" },
        "payload": { "$ref": "#/$defs/sceneLoadEraPayload" }
      }
    },
    "sceneAddFeaturesMessage": {
      "description": "Shell to Player. Adds features to an era that was already loaded; they rise from the ground (fade only under reduced motion). The Shell sends only features the era does not hold yet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "scene/addFeatures" },
        "payload": { "$ref": "#/$defs/sceneAddFeaturesPayload" }
      }
    },
    "sceneSetDepthMessage": {
      "description": "Shell to Player. Which era is shown.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "scene/setDepth" },
        "payload": { "$ref": "#/$defs/sceneSetDepthPayload" }
      }
    },
    "sceneFocusLotMessage": {
      "description": "Shell to Player (0.5.0; 0.6.0 drops the lamp). Pins a lot: outlined on the ground in `lantern` in every era, the lit map sheet's light pool moves to it, and the camera flies to frame it (eased, 900 ms; a cut under reduced motion). Nothing else marks the lot. A second scene/focusLot replaces the first.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "scene/focusLot" },
        "payload": { "$ref": "#/$defs/sceneFocusLotPayload" }
      }
    },
    "sceneClearLotMessage": {
      "description": "Shell to Player (0.5.0). Unpins the lot and restores the default view (eased, or a cut under reduced motion). With no lot pinned it does nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "scene/clearLot" },
        "payload": { "$ref": "#/$defs/sceneClearLotPayload" }
      }
    },
    "sceneSetDrapeModeMessage": {
      "description": "Shell to Player (0.5.0). Switches drapes between the lit display (the default: toned toward `ink` paper under the light pool) and the untouched scan (\"view original scan\"). Affects the Explorer scene only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "scene/setDrapeMode" },
        "payload": { "$ref": "#/$defs/sceneSetDrapeModePayload" }
      }
    },
    "sceneSetLanternMessage": {
      "description": "Shell to Player (0.6.0). The Lantern: while on, a circular lens at `center` (radius a fraction of the canvas height) shows the era named by eraId (its lit plate and ghosts) inside it and Today outside it, with a thin `ink` ring on its edge. Honoured at Today only; the Shell does not send it at another depth. Off removes the lens. Reduced motion: it appears and disappears without easing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "scene/setLantern" },
        "payload": { "$ref": "#/$defs/sceneSetLanternPayload" }
      }
    },
    "sceneShowEvidenceMessage": {
      "description": "Shell to Player (0.6.0). Show Evidence for one ghost: while on, that ghost is nearly transparent with its outline kept, and the given source's untouched scan (never the lit display) is drawn beneath its footprint and a few metres around it, at full opacity. Every other drape keeps its lit look. Off restores the lit sheet. The camera does not move.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "scene/showEvidence" },
        "payload": { "$ref": "#/$defs/sceneShowEvidencePayload" }
      }
    },
    "debugMarkersMessage": {
      "description": "Shell to Player. Only honoured when scene/init had debug: true.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "debug/markers" },
        "payload": { "$ref": "#/$defs/debugMarkersPayload" }
      }
    },
    "debugSetCameraMessage": {
      "description": "Shell to Player. Sets the camera pose exactly. Only honoured when scene/init had debug: true; otherwise refused with debug_disabled.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "debug/setCamera" },
        "payload": { "$ref": "#/$defs/debugSetCameraPayload" }
      }
    },
    "readyMessage": {
      "description": "Player to Shell. Sent once, after the first rendered frame.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "ready" },
        "payload": { "$ref": "#/$defs/readyPayload" }
      }
    },
    "eraLoadedMessage": {
      "description": "Player to Shell. An era's meshes are built and its drape textures have loaded or failed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "eraLoaded" },
        "payload": { "$ref": "#/$defs/eraLoadedPayload" }
      }
    },
    "featureClickedMessage": {
      "description": "Player to Shell. A click on a drawn feature.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "featureClicked" },
        "payload": { "$ref": "#/$defs/featureClickedPayload" }
      }
    },
    "cameraChangedMessage": {
      "description": "Player to Shell. The camera pose, at most 10 times a second while it moves, once when it stops, after scene/init, and after every scene/setDepth.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "cameraChanged" },
        "payload": { "$ref": "#/$defs/cameraChangedPayload" }
      }
    },
    "errorMessage": {
      "description": "Player to Shell. A refusal or a failure.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "const": "error" },
        "payload": { "$ref": "#/$defs/errorPayload" }
      }
    },

    "sceneInitPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridgeVersion", "origin", "bounds", "initialView", "eras", "present", "reducedMotion", "debug"],
      "properties": {
        "bridgeVersion": { "const": "0.7.0" },
        "origin": { "$ref": "#/$defs/originPoint" },
        "bounds": { "$ref": "#/$defs/sceneBounds" },
        "initialView": {
          "description": "The rectangle the default camera pose frames, centred on the canvas. It lies inside bounds (checked by both parsers).",
          "$ref": "#/$defs/rect"
        },
        "eras": {
          "description": "At least one era. Indexes are exactly 0 to n-1, each once; 0 is Today.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/eraRef" }
        },
        "present": {
          "description": "Today's buildings, each with a fixed display height.",
          "type": "array",
          "items": { "$ref": "#/$defs/presentBuilding" }
        },
        "reducedMotion": { "type": "boolean" },
        "debug": { "type": "boolean" }
      }
    },
    "sceneLoadEraPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eraId", "features", "drapes"],
      "properties": {
        "eraId": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "features": { "type": "array", "items": { "$ref": "#/$defs/sceneFeature" } },
        "drapes": { "type": "array", "items": { "$ref": "#/$defs/drape" } }
      }
    },
    "sceneAddFeaturesPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eraId", "features"],
      "properties": {
        "eraId": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "features": { "type": "array", "items": { "$ref": "#/$defs/sceneFeature" } }
      }
    },
    "sceneSetDepthPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth"],
      "properties": {
        "depth": {
          "description": "0 is Today. An integer is an era; a fraction is a transition. The Player also refuses a depth past the last era it was told about.",
          "type": "number",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "sceneFocusLotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lot"],
      "properties": {
        "lot": {
          "description": "The lot polygon (or MultiPolygon) in EPSG:26917 metres, from the City property boundaries. Rings are closed (checked by both parsers).",
          "$ref": "#/$defs/polygonalGeometry"
        }
      }
    },
    "sceneClearLotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "sceneSetDrapeModePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["lit", "original"] },
        "sourceId": {
          "description": "Optional. The drape to switch. Absent: every drape in the scene.",
          "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/sourceId"
        }
      }
    },
    "sceneSetLanternPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "center", "radius", "eraId"],
      "properties": {
        "on": { "type": "boolean" },
        "center": {
          "description": "The lens centre in normalised canvas coordinates: x from the left edge, y from the top edge, each 0 to 1.",
          "$ref": "#/$defs/screenPoint"
        },
        "radius": {
          "description": "The lens radius as a fraction of the canvas height.",
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.5
        },
        "eraId": {
          "description": "The era shown inside the lens. It must be listed in scene/init (else era_not_initialised).",
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        }
      }
    },
    "sceneShowEvidencePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "on"],
      "properties": {
        "featureId": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/featureId" },
        "on": { "type": "boolean" },
        "drape": {
          "description": "Optional in the schema, required when on is true and absent when it is false (checked by both parsers). The source raster to show: the drape of the feature's origin source, which may not be draped in the current era.",
          "$ref": "#/$defs/drape"
        }
      }
    },
    "debugMarkersPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markers"],
      "properties": {
        "markers": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/markerEntry" } }
      }
    },
    "debugSetCameraPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "distanceM", "pitchDeg", "headingDeg"],
      "properties": {
        "target": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/position" },
        "distanceM": { "type": "number", "minimum": 30, "maximum": 3000 },
        "pitchDeg": { "type": "number", "minimum": 20, "maximum": 80 },
        "headingDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
      }
    },
    "readyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridgeVersion", "unityVersion"],
      "properties": {
        "bridgeVersion": { "const": "0.7.0" },
        "unityVersion": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "eraLoadedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eraId", "featureCount", "drapeCount", "failedDrapes"],
      "properties": {
        "eraId": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "featureCount": { "type": "integer", "minimum": 0 },
        "drapeCount": { "type": "integer", "minimum": 0 },
        "failedDrapes": {
          "type": "array",
          "items": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/sourceId" }
        }
      }
    },
    "featureClickedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "eraId"],
      "properties": {
        "featureId": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/featureId" },
        "eraId": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" }
      }
    },
    "cameraChangedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eye", "target", "fovDeg", "viewProjection", "canvas"],
      "properties": {
        "eye": { "$ref": "#/$defs/cameraPoint" },
        "target": { "$ref": "#/$defs/cameraPoint" },
        "fovDeg": { "description": "Vertical field of view in degrees.", "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
        "viewProjection": {
          "description": "Projection times view, 16 numbers, column-major: element (row r, column c) is at index c * 4 + r. Unity world space (x east, y up, z north), OpenGL clip conventions: x and y of clip / w run from -1 (left, bottom) to 1 (right, top).",
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": { "type": "number" }
        },
        "canvas": { "$ref": "#/$defs/canvasSize" }
      }
    },
    "errorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "messageType"],
      "properties": {
        "code": {
          "enum": [
            "invalid_message",
            "unknown_type",
            "bridge_version_mismatch",
            "bounds_too_far",
            "era_not_initialised",
            "texture_load_failed",
            "mesh_build_failed",
            "debug_disabled"
          ]
        },
        "message": { "type": "string", "maxLength": 2000 },
        "messageType": { "type": ["string", "null"] }
      }
    },

    "originPoint": {
      "description": "The project origin (E0, N0) in EPSG:26917 metres, read by the Shell from data/project.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["easting", "northing"],
      "properties": {
        "easting": { "type": "number", "minimum": 166000, "maximum": 834000 },
        "northing": { "type": "number", "minimum": 0, "maximum": 9400000 }
      }
    },
    "sceneBounds": {
      "description": "The project bounds in EPSG:26917 metres. Each corner must be within 4000 m of the origin.",
      "type": "object",
      "additionalProperties": false,
      "required": ["minE", "minN", "maxE", "maxN"],
      "properties": {
        "minE": { "type": "number", "minimum": 166000, "maximum": 834000 },
        "minN": { "type": "number", "minimum": 0, "maximum": 9400000 },
        "maxE": { "type": "number", "minimum": 166000, "maximum": 834000 },
        "maxN": { "type": "number", "minimum": 0, "maximum": 9400000 }
      }
    },
    "rect": {
      "description": "An axis-aligned rectangle in EPSG:26917 metres. minE < maxE and minN < maxN (checked by both parsers).",
      "type": "object",
      "additionalProperties": false,
      "required": ["minE", "minN", "maxE", "maxN"],
      "properties": {
        "minE": { "type": "number", "minimum": 166000, "maximum": 834000 },
        "minN": { "type": "number", "minimum": 0, "maximum": 9400000 },
        "maxE": { "type": "number", "minimum": 166000, "maximum": 834000 },
        "maxN": { "type": "number", "minimum": 0, "maximum": 9400000 }
      }
    },
    "eraRef": {
      "description": "An era by id and index only. The Player never sees what years an era covers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "index"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "index": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    },
    "presentBuilding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "geometry", "heightM"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "geometry": { "$ref": "#/$defs/polygonalGeometry" },
        "heightM": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
      }
    },
    "sceneFeature": {
      "description": "What the Player needs to draw one feature of an era. A building or a land-use area has polygon geometry; water may be any of the four geometry types. A land_use area (0.7.0) is drawn flat on the ground as a hatched `ink` fill at low opacity with a thin outline, under the ghosts, and can be clicked: the Player draws it as a sheet a few centimetres thick whatever heightM says (the Shell sends 0.05), and nothing of it rises.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "geometry", "confidence", "heightM"],
      "properties": {
        "id": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/featureId" },
        "kind": { "enum": ["building", "water", "land_use"] },
        "geometry": { "$ref": "#/$defs/geometry" },
        "confidence": { "enum": ["documented", "estimated", "unknown"] },
        "heightM": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "storeys": {
          "description": "Optional (bridge 0.5.0). The recorded storey count of a building: the Player draws one line per storey. Absent: no count is recorded and no storey lines are drawn; heightM is the display height either way. Never invented.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["building", "land_use"] } }, "required": ["kind"] },
          "then": { "properties": { "geometry": { "$ref": "#/$defs/polygonalGeometry" } } }
        }
      ]
    },
    "drape": {
      "description": "A tile from data/tiles/ placed on the ground by its four corners.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "url", "corners", "widthPx", "heightPx"],
      "properties": {
        "sourceId": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/sourceId" },
        "url": { "type": "string", "pattern": "^/data/tiles/[a-z0-9_]+\\.(jpg|png)$" },
        "corners": { "$ref": "#/$defs/drapeCorners" },
        "widthPx": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "heightPx": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "clip": {
          "description": "Optional (bridge 0.3.0). The plate's map area as a closed Polygon in EPSG:26917 metres, from the tile sidecar's map_area. The drape shows only inside it. Absent: the four corners bound the drape.",
          "$ref": "#/$defs/polygonGeometry"
        },
        "kind": {
          "description": "Optional (bridge 0.5.0). plate: the lit display tones the greyscale scan toward `ink` paper. aerial: lit but not recoloured. Absent: plate.",
          "enum": ["plate", "aerial"]
        }
      }
    },
    "drapeCorners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topLeft", "topRight", "bottomRight", "bottomLeft"],
      "properties": {
        "topLeft": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/position" },
        "topRight": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/position" },
        "bottomRight": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/position" },
        "bottomLeft": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/position" }
      }
    },
    "markerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "position": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/position" }
      }
    },
    "screenPoint": {
      "description": "A point on the canvas in normalised coordinates: x from the left edge, y from the top edge, each 0 to 1.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "cameraPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["easting", "northing", "heightM"],
      "properties": {
        "easting": { "type": "number", "minimum": 166000, "maximum": 834000 },
        "northing": { "type": "number", "minimum": 0, "maximum": 9400000 },
        "heightM": { "type": "number", "minimum": -1000, "maximum": 100000 }
      }
    },
    "canvasSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx"],
      "properties": {
        "widthPx": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "heightPx": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },

    "ring": {
      "description": "A ring of at least four positions whose first and last positions are equal (checked by both parsers).",
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "https://buried.invalid/schema/evidence.schema.json#/$defs/position" }
    },
    "polygonGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
