{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buried.invalid/schema/evidence.schema.json",
  "title": "Buried contract files",
  "description": "The one schema for every Buried contract file under data/. All coordinates are EPSG:26917 (NAD83 / UTM zone 17N) metres, easting first then northing, and never longitude/latitude. The root validates a featureCollection (an evidence file); every other contract file is validated against its own entry under $defs. The schema is 1.2.0: an evidence file carries schema_version 1.2.0 (provenance.review); the other contract files keep the stamp they were written with (1.1.0 or 1.0.0).",
  "$ref": "#/$defs/featureCollection",
  "$defs": {
    "schemaVersion": {
      "description": "MAJOR.MINOR.PATCH. A change to this schema bumps it here and in every contract file it affects.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "sourceId": {
      "description": "A source id, built as in structure.md: lowercase snake_case.",
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "featureId": {
      "description": "<bld|wtr|use>_<origin source id>_<4 digits>.",
      "type": "string",
      "pattern": "^(bld|wtr|use)_[a-z0-9]+(_[a-z0-9]+)*_\\d{4}$"
    },
    "position": {
      "description": "One position in EPSG:26917 metres: [easting, northing]. Never longitude/latitude: a pair such as [-79.35, 43.65] fails the easting minimum. Exactly two numbers.",
      "type": "array",
      "prefixItems": [
        { "description": "Easting in EPSG:26917 metres.", "type": "number", "minimum": 166000, "maximum": 834000 },
        { "description": "Northing in EPSG:26917 metres.", "type": "number", "minimum": 0, "maximum": 9400000 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "date": {
      "description": "An ISO 8601 calendar date.",
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "description": "An RFC 3339 date-time.",
      "type": "string",
      "format": "date-time"
    },
    "bounds": {
      "description": "A rectangle in EPSG:26917 metres.",
      "type": "object",
      "additionalProperties": false,
      "required": ["min_e", "min_n", "max_e", "max_n"],
      "properties": {
        "min_e": { "type": "number", "minimum": 166000, "maximum": 834000 },
        "min_n": { "type": "number", "minimum": 0, "maximum": 9400000 },
        "max_e": { "type": "number", "minimum": 166000, "maximum": 834000 },
        "max_n": { "type": "number", "minimum": 0, "maximum": 9400000 }
      }
    },
    "linearRing": {
      "description": "A closed ring of EPSG:26917 positions (at least four, first equal to last is checked by the Validator).",
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/position" }
    },
    "pointGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": { "$ref": "#/$defs/position" }
      }
    },
    "polygonGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } }
      }
    },
    "multiPolygonGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiPolygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } }
        }
      }
    },
    "lineStringGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
      }
    },
    "multiLineStringGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiLineString" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
        }
      }
    },
    "polygonalGeometry": {
      "description": "Polygon or MultiPolygon in EPSG:26917 metres.",
      "oneOf": [
        { "$ref": "#/$defs/polygonGeometry" },
        { "$ref": "#/$defs/multiPolygonGeometry" }
      ]
    },
    "featureGeometry": {
      "description": "Polygon, MultiPolygon, LineString or MultiLineString in EPSG:26917 metres. Lines are allowed for water features only (enforced in feature).",
      "oneOf": [
        { "$ref": "#/$defs/polygonGeometry" },
        { "$ref": "#/$defs/multiPolygonGeometry" },
        { "$ref": "#/$defs/lineStringGeometry" },
        { "$ref": "#/$defs/multiLineStringGeometry" }
      ]
    },
    "pixelPoint": {
      "description": "[x, y] integer pixel vertex on a source raster (GDAL convention: (0, 0) is the top-left corner of the top-left pixel).",
      "type": "array",
      "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }],
      "minItems": 2,
      "maxItems": 2
    },
    "cropPx": {
      "description": "An integer pixel rectangle on a source raster at full resolution (GDAL convention).",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "coverageArea": {
      "description": "A Polygon or MultiPolygon in EPSG:26917 metres with the method that produced it. A reviewed area (method person) is a person's statement that every feature of the kinds it covers (buildings when covers is absent) that the origin source draws inside it is published in the file. method map_area is the plate's map area polygon through the chosen transform (mapped_area only).",
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "method"],
      "properties": {
        "geometry": { "$ref": "#/$defs/polygonalGeometry" },
        "method": { "enum": ["neatline", "raster_footprint", "map_area", "person"] },
        "covers": {
          "description": "Reviewed areas only. The kinds of feature the person attests are all published inside the area. Absent means [\"building\"].",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["building", "water", "land_use"] }
        },
        "pixel_polygon": {
          "description": "Integer pixel vertices on the origin source (GDAL convention).",
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "confirmed_by": { "type": "string", "minLength": 1 },
        "confirmed_at": { "$ref": "#/$defs/dateTime" }
      },
      "if": { "properties": { "method": { "const": "person" } }, "required": ["method"] },
      "then": { "required": ["pixel_polygon", "confirmed_by", "confirmed_at"] }
    },
    "link": {
      "description": "A link to a feature from another source that shows the same thing. Linking is not merging.",
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "method"],
      "properties": {
        "feature": { "$ref": "#/$defs/featureId" },
        "method": { "enum": ["match_auto", "person"] },
        "confirmed_by": { "type": "string", "minLength": 1 },
        "confirmed_at": { "$ref": "#/$defs/dateTime" }
      },
      "if": { "properties": { "method": { "const": "person" } }, "required": ["method"] },
      "then": { "required": ["confirmed_by", "confirmed_at"] }
    },
    "observation": {
      "description": "What one source shows at the feature's location. No year: the year range comes from the source in the registry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "present", "visibility", "method"],
      "properties": {
        "source": { "$ref": "#/$defs/sourceId" },
        "present": { "type": "boolean" },
        "visibility": { "enum": ["clear", "obscured", "not_covered"] },
        "method": { "enum": ["origin", "match_auto", "person"] },
        "matched_feature": { "$ref": "#/$defs/featureId" },
        "confirmed_by": { "type": "string", "minLength": 1 },
        "confirmed_at": { "$ref": "#/$defs/dateTime" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "person" } }, "required": ["method"] },
          "then": { "required": ["confirmed_by", "confirmed_at"] }
        },
        {
          "description": "An origin observation says the feature was read from this source, so it is a presence (requirement 27.2).",
          "if": { "properties": { "method": { "const": "origin" } }, "required": ["method"] },
          "then": { "properties": { "present": { "const": true } } }
        },
        {
          "if": {
            "properties": { "method": { "const": "match_auto" }, "present": { "const": true } },
            "required": ["method", "present"]
          },
          "then": { "required": ["matched_feature"] }
        }
      ]
    },
    "attributeRead": {
      "description": "Where on the origin source one attribute was read, and by whom. A read by label_assist names the provider and model that proposed the text; a person confirmed it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "crop_px", "read_by", "confirmed_by", "confirmed_at"],
      "properties": {
        "attribute": { "enum": ["use", "material", "storeys", "street_number"] },
        "crop_px": { "$ref": "#/$defs/cropPx" },
        "read_by": { "enum": ["person", "label_assist"] },
        "provider": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "confirmed_by": { "type": "string", "minLength": 1 },
        "confirmed_at": { "$ref": "#/$defs/dateTime" }
      },
      "if": { "properties": { "read_by": { "const": "label_assist" } }, "required": ["read_by"] },
      "then": { "required": ["provider", "model_id"] }
    },
    "reviewState": {
      "description": "Whether a named person has reviewed the feature. reviewed: a person looked at the feature against its source and named themselves (by) and the day (on). draft_rule: drawn by rule-based extraction and published, not reviewed. draft_hand: traced by hand and published, not reviewed. A draft carries no by or on. This is not the publishing record: confirmed_by and confirmed_at say who accepted the proposal into the file and are never printed as a status.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["reviewed", "draft_rule", "draft_hand"] },
        "by": { "type": "string", "minLength": 1 },
        "on": { "$ref": "#/$defs/date" }
      },
      "if": { "properties": { "state": { "const": "reviewed" } }, "required": ["state"] },
      "then": { "required": ["by", "on"] },
      "else": { "not": { "anyOf": [{ "required": ["by"] }, { "required": ["on"] }] } }
    },
    "provenance": {
      "description": "Where a feature came from, who confirmed it and how far off its outline may be. Pixel coordinates use the GDAL convention: (0, 0) is the top-left corner of the top-left pixel of the full-resolution source raster.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_source",
        "crop_px",
        "alignment_error_m",
        "digitising_error_m",
        "confirmed_by",
        "confirmed_at",
        "review"
      ],
      "properties": {
        "origin_source": { "$ref": "#/$defs/sourceId" },
        "crop_px": { "$ref": "#/$defs/cropPx" },
        "alignment_error_m": { "type": "number", "exclusiveMinimum": 0 },
        "digitising_error_m": { "type": "number", "exclusiveMinimum": 0 },
        "confirmed_by": { "type": "string", "minLength": 1 },
        "confirmed_at": { "$ref": "#/$defs/dateTime" },
        "review": { "$ref": "#/$defs/reviewState" },
        "proposal_id": { "type": "string" },
        "extraction_params_id": { "type": "string" },
        "attribute_reads": {
          "description": "One entry per attribute read from lettering or the legend on the origin source, with the crop it was read from. A material needs one.",
          "type": "array",
          "items": { "$ref": "#/$defs/attributeRead" }
        },
        "tone_class": {
          "description": "The fill tone extraction observed on the scan. A fact about the image, not an attribute: no consumer presents it as a material.",
          "enum": ["light", "mid", "dark", "hatched", "mixed"]
        }
      }
    },
    "attributes": {
      "description": "Attributes read from the source. Each is optional and never guessed. material is set only from lettering or the legend, and then provenance.attribute_reads has its read.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use": { "type": "string" },
        "material": { "type": "string" },
        "storeys": { "type": "integer", "minimum": 1 },
        "street_number": { "description": "The street number as printed on the source.", "type": "string" }
      }
    },
    "feature": {
      "description": "One building (bld), water feature (wtr) or land-use area (use). Geometry is EPSG:26917 metres.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "$ref": "#/$defs/featureId" },
        "geometry": { "$ref": "#/$defs/featureGeometry" },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "position_error_m",
            "attributes",
            "observations",
            "confidence",
            "confidence_reason",
            "provenance",
            "status"
          ],
          "properties": {
            "kind": { "enum": ["building", "water", "land_use"] },
            "position_error_m": {
              "description": "About how far, in metres, the true position may be from where the feature is drawn. A conservative estimate, not an absolute bound.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "attributes": { "$ref": "#/$defs/attributes" },
            "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/observation" } },
            "confidence": { "enum": ["documented", "estimated", "unknown"] },
            "confidence_reason": { "type": "string", "minLength": 1 },
            "provenance": { "$ref": "#/$defs/provenance" },
            "status": { "enum": ["published", "rejected", "merged"] },
            "status_reason": { "type": "string", "minLength": 1 },
            "merged_into": { "$ref": "#/$defs/featureId" },
            "same_as": { "type": "array", "items": { "$ref": "#/$defs/link" } }
          },
          "allOf": [
            {
              "if": {
                "properties": { "kind": { "const": "building" }, "confidence": { "const": "documented" } },
                "required": ["kind", "confidence"]
              },
              "then": { "properties": { "attributes": { "required": ["storeys"] } } }
            },
            {
              "if": { "properties": { "status": { "const": "merged" } }, "required": ["status"] },
              "then": { "required": ["merged_into"] }
            },
            {
              "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
              "then": { "required": ["status_reason"] }
            },
            {
              "description": "A material comes only from lettering or the legend, so it needs a recorded read (requirement 25.2).",
              "if": {
                "properties": { "attributes": { "required": ["material"] } },
                "required": ["attributes"]
              },
              "then": {
                "properties": {
                  "provenance": {
                    "required": ["attribute_reads"],
                    "properties": {
                      "attribute_reads": {
                        "contains": {
                          "properties": { "attribute": { "const": "material" } },
                          "required": ["attribute"]
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "properties": { "properties": { "kind": { "const": "building" } }, "required": ["kind"] } }, "required": ["properties"] },
          "then": { "properties": { "id": { "pattern": "^bld_" }, "geometry": { "$ref": "#/$defs/polygonalGeometry" } } }
        },
        {
          "if": { "properties": { "properties": { "properties": { "kind": { "const": "land_use" } }, "required": ["kind"] } }, "required": ["properties"] },
          "then": { "properties": { "id": { "pattern": "^use_" }, "geometry": { "$ref": "#/$defs/polygonalGeometry" } } }
        },
        {
          "if": { "properties": { "properties": { "properties": { "kind": { "const": "water" } }, "required": ["kind"] } }, "required": ["properties"] },
          "then": { "properties": { "id": { "pattern": "^wtr_" } } }
        }
      ]
    },
    "featureCollection": {
      "description": "An evidence file: data/evidence/<origin source id>.geojson. GeoJSON-shaped but in EPSG:26917 metres, not WGS84; do not hand it to a library that assumes lon/lat.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schema_version", "crs", "origin_source", "features"],
      "properties": {
        "type": { "const": "FeatureCollection" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "crs": { "const": "EPSG:26917" },
        "origin_source": { "$ref": "#/$defs/sourceId" },
        "mapped_area": {
          "description": "Where the origin source draws the ground: the plate's map area through the chosen transform, its neatline, or the raster footprint under the chosen transform.",
          "allOf": [
            { "$ref": "#/$defs/coverageArea" },
            {
              "properties": { "method": { "enum": ["neatline", "raster_footprint", "map_area"] } },
              "not": { "required": ["covers"] }
            }
          ]
        },
        "reviewed_areas": {
          "description": "Areas where a person attests that every feature of the kinds in covers (buildings when covers is absent) that the origin source draws is published.",
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/coverageArea" },
              { "properties": { "method": { "const": "person" } } }
            ]
          }
        },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } }
      }
    },
    "source": {
      "description": "One archival item or present-day dataset, registered once. year_from is null only for a present_day_reference source whose CKAN last-refresh year has not been read yet; evidence cannot cite such a source.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "year_from",
        "year_to",
        "url",
        "licence_note",
        "attribution_line",
        "attribution_status",
        "rights_checked_on",
        "held_out"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/sourceId" },
        "type": { "enum": ["fire_insurance_plan", "aerial_photograph", "present_day_reference", "historical_map"] },
        "title": { "type": "string", "minLength": 1 },
        "year_from": { "type": ["integer", "null"] },
        "year_to": { "type": "integer" },
        "url": { "type": "string", "format": "uri" },
        "licence_note": { "type": "string", "minLength": 1 },
        "attribution_line": { "type": "string", "minLength": 1 },
        "attribution_status": { "enum": ["confirmed", "to_be_confirmed"] },
        "rights_checked_on": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "held_out": { "type": "boolean" },
        "years_label": {
          "description": "Display only, for example \"1931, revised to 1935\". The date logic never reads it. The Validator checks it states exactly year_from and year_to and no other year.",
          "type": "string",
          "minLength": 1
        },
        "holding": {
          "description": "The institution that holds the original, when it differs from the distributor.",
          "type": "string",
          "minLength": 1
        }
      },
      "if": { "properties": { "type": { "const": "present_day_reference" } }, "required": ["type"] },
      "else": { "properties": { "year_from": { "type": "integer" } } }
    },
    "sourceRegistry": {
      "description": "data/sources.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sources"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
      }
    },
    "era": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "year_from", "year_to"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "year_from": { "type": "integer" },
        "year_to": { "type": "integer" }
      }
    },
    "project": {
      "description": "data/project.json: the project origin, bounds and eras. Coordinates are EPSG:26917 metres.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "crs", "origin", "origin_note", "bounds", "eras"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "crs": { "const": "EPSG:26917" },
        "origin": {
          "description": "The project origin (E0, N0) in EPSG:26917 metres. Frozen once evidence is published.",
          "type": "object",
          "additionalProperties": false,
          "required": ["easting", "northing"],
          "properties": {
            "easting": { "type": "number", "minimum": 166000, "maximum": 834000 },
            "northing": { "type": "number", "minimum": 0, "maximum": 9400000 }
          }
        },
        "origin_note": { "type": "string", "minLength": 1 },
        "bounds": { "$ref": "#/$defs/bounds" },
        "eras": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/era" } }
      }
    },
    "controlPoint": {
      "description": "One control point: a pixel on the plate paired with a present-day feature. reference is EPSG:26917 metres, copied from the present layer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "pixel",
        "reference",
        "reference_source",
        "reference_kind",
        "reference_feature_id"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "pixel": {
          "description": "[x, y] in the full-resolution raster, GDAL convention.",
          "type": "array",
          "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }],
          "minItems": 2,
          "maxItems": 2
        },
        "reference": { "$ref": "#/$defs/position" },
        "reference_source": { "$ref": "#/$defs/sourceId" },
        "reference_kind": { "enum": ["intersection", "building_corner"] },
        "reference_feature_id": { "type": "string", "minLength": 1 },
        "reference_vertex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["polygon", "vertex"],
          "properties": {
            "polygon": { "type": "integer", "minimum": 0 },
            "vertex": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "if": { "properties": { "reference_kind": { "const": "building_corner" } }, "required": ["reference_kind"] },
      "then": { "required": ["reference_vertex"] }
    },
    "controlPoints": {
      "description": "data/control/<source id>.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source", "pixel_convention", "points"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "source": { "$ref": "#/$defs/sourceId" },
        "pixel_convention": { "const": "gdal_corner" },
        "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/controlPoint" } }
      }
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dx_m", "dy_m", "r_m"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "dx_m": { "type": "number" },
        "dy_m": { "type": "number" },
        "r_m": { "type": "number", "minimum": 0 }
      }
    },
    "alignmentRecord": {
      "description": "data/alignment/<source id>.json, written by buried align-check. alignment_error_m = ceil_0.1(max(2.0, 2 x error_basis_m)).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "reference_sources",
        "control_file",
        "control_sha256",
        "measured_at",
        "tool_version",
        "status",
        "source_pixel_size_m",
        "chosen",
        "error_basis",
        "error_basis_m",
        "error_rule",
        "alignment_error_m",
        "outliers"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "source": { "$ref": "#/$defs/sourceId" },
        "reference_sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceId" } },
        "control_file": { "type": "string", "minLength": 1 },
        "control_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "measured_at": { "$ref": "#/$defs/dateTime" },
        "tool_version": { "type": "string", "minLength": 1 },
        "status": { "const": "measured" },
        "source_pixel_size_m": { "type": "number", "exclusiveMinimum": 0 },
        "supplied": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crs", "operation", "residuals", "rmse_m", "max_residual_m"],
          "properties": {
            "crs": { "type": "string", "minLength": 1 },
            "operation": { "type": "string" },
            "residuals": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/residual" } },
            "rmse_m": { "type": "number", "minimum": 0 },
            "max_residual_m": { "type": "number", "minimum": 0 }
          }
        },
        "refined": {
          "type": "object",
          "additionalProperties": false,
          "required": ["affine", "residuals", "rmse_in_sample_m", "rmse_loo_m", "max_residual_m"],
          "properties": {
            "affine": {
              "description": "[a, b, c, d, e, f]: E = a x + b y + c, N = d x + e y + f, pixel to EPSG:26917.",
              "type": "array",
              "items": { "type": "number" },
              "minItems": 6,
              "maxItems": 6
            },
            "residuals": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/residual" } },
            "rmse_in_sample_m": { "type": "number", "minimum": 0 },
            "rmse_loo_m": { "type": "number", "minimum": 0 },
            "max_residual_m": { "type": "number", "minimum": 0 }
          }
        },
        "chosen": { "enum": ["supplied", "refined"] },
        "error_basis": { "enum": ["supplied_rmse", "refined_loo_rmse"] },
        "error_basis_m": { "type": "number", "exclusiveMinimum": 0 },
        "error_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["multiplier", "floor_m", "round_up_to_m"],
          "properties": {
            "multiplier": { "const": 2.0 },
            "floor_m": { "const": 2.0 },
            "round_up_to_m": { "const": 0.1 }
          }
        },
        "alignment_error_m": { "type": "number", "minimum": 2.0 },
        "outliers": { "type": "array", "items": { "type": "string" } },
        "control_hull": {
          "description": "The convex hull of the control points' reference positions, EPSG:26917 metres, 3 decimals. The error figure is measured inside it. Required of records written after schema 1.1.0 (checked by the Validator, which accepts a record without it only at schema_version 1.0.0).",
          "$ref": "#/$defs/polygonGeometry"
        },
        "control_hull_area_m2": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "description": "supplied is optional when the refined fit was chosen, required when the supplied georeferencing was (requirement 26.1).",
          "if": { "properties": { "chosen": { "const": "refined" } }, "required": ["chosen"] },
          "then": { "required": ["refined"], "properties": { "error_basis": { "const": "refined_loo_rmse" } } },
          "else": { "required": ["supplied"], "properties": { "error_basis": { "const": "supplied_rmse" } } }
        }
      ]
    },
    "tileSidecar": {
      "description": "data/tiles/<source id>.json. Corner coordinates are EPSG:26917 metres.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "image",
        "width_px",
        "height_px",
        "corners",
        "transform",
        "alignment_error_m",
        "source_pixel_size_m",
        "tile_pixel_size_m",
        "attribution_line"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "source": { "$ref": "#/$defs/sourceId" },
        "image": { "type": "string", "pattern": "^[a-z0-9_]+\\.jpg$" },
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "corners": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top_left", "top_right", "bottom_right", "bottom_left"],
          "properties": {
            "top_left": { "$ref": "#/$defs/position" },
            "top_right": { "$ref": "#/$defs/position" },
            "bottom_right": { "$ref": "#/$defs/position" },
            "bottom_left": { "$ref": "#/$defs/position" }
          }
        },
        "transform": { "enum": ["supplied", "refined"] },
        "alignment_error_m": { "type": "number", "exclusiveMinimum": 0 },
        "source_pixel_size_m": { "type": "number", "exclusiveMinimum": 0 },
        "tile_pixel_size_m": { "type": "number", "exclusiveMinimum": 0 },
        "attribution_line": { "type": "string", "minLength": 1 },
        "crop_px": {
          "description": "The full-resolution pixel rectangle the tile covers: the bounding box of the plate's map area.",
          "$ref": "#/$defs/cropPx"
        },
        "map_area": {
          "description": "The plate's map area polygon in EPSG:26917 metres (its pixel polygon through the chosen transform), so the Explorer can clip the drape to it.",
          "$ref": "#/$defs/polygonGeometry"
        },
        "full_image": {
          "description": "File name next to the sidecar of a downsampled copy of the whole raster, for the Sources page. Never draped.",
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.jpg$"
        },
        "full_width_px": { "type": "integer", "minimum": 1 },
        "full_height_px": { "type": "integer", "minimum": 1 }
      },
      "dependentRequired": {
        "crop_px": ["map_area"],
        "map_area": ["crop_px"],
        "full_image": ["full_width_px", "full_height_px"],
        "full_width_px": ["full_image"],
        "full_height_px": ["full_image"]
      }
    },
    "mapArea": {
      "description": "data/control/map_area/<source id>.json: a person's statement of where map content is on a plate image. Margins, title blocks, scale bars, north arrows, archive labels and rulers lie outside it. Code never detects it silently.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "pixel_convention",
        "pixel_polygon",
        "excluded",
        "confirmed_by",
        "confirmed_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "source": { "$ref": "#/$defs/sourceId" },
        "pixel_convention": { "const": "gdal_corner" },
        "pixel_polygon": {
          "description": "Integer pixel vertices of one simple polygon in full-resolution pixels, at least four, the first vertex not repeated at the end.",
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/pixelPoint" }
        },
        "excluded": {
          "description": "What lies outside the polygon, for example \"margin, title block, archive labels, ruler\".",
          "type": "string",
          "minLength": 1
        },
        "fold_lines": {
          "description": "Integer pixel polylines a person marked where the paper was folded.",
          "type": "array",
          "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/pixelPoint" } }
        },
        "confirmed_by": { "type": "string", "minLength": 1 },
        "confirmed_at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "presentFeature": {
      "description": "A present-day City of Toronto feature in EPSG:26917 metres. Reference data, not evidence: it carries no observations.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "type": "string", "minLength": 1 },
        "geometry": {
          "oneOf": [
            { "$ref": "#/$defs/pointGeometry" },
            { "$ref": "#/$defs/polygonGeometry" },
            { "$ref": "#/$defs/multiPolygonGeometry" }
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        }
      }
    },
    "presentLayer": {
      "description": "data/present/<source id>.geojson: a present-day layer clipped to the project bounds, in EPSG:26917 metres.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "crs",
        "source",
        "ckan_package_id",
        "ckan_resource_id",
        "resource_url",
        "retrieved_at",
        "last_refreshed",
        "source_sha256",
        "id_field",
        "clip_bounds",
        "attribution_line",
        "features"
      ],
      "properties": {
        "type": { "const": "FeatureCollection" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "crs": { "const": "EPSG:26917" },
        "source": { "$ref": "#/$defs/sourceId" },
        "ckan_package_id": { "type": "string", "minLength": 1 },
        "ckan_resource_id": { "type": "string", "minLength": 1 },
        "resource_url": { "type": "string", "format": "uri" },
        "retrieved_at": { "$ref": "#/$defs/dateTime" },
        "last_refreshed": { "$ref": "#/$defs/date" },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "id_field": { "type": "string", "minLength": 1 },
        "clip_bounds": { "$ref": "#/$defs/bounds" },
        "attribution_line": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "items": { "$ref": "#/$defs/presentFeature" } }
      }
    }
  }
}
