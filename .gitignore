# OS / editors
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Node
node_modules/
dist/
.vite/
coverage/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.hypothesis/

# Unity (project lives in unity/)
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/*.csproj
unity/*.sln
unity/*.slnx
unity/TestResults/
unity/[Mm]emoryCaptures/

# The Unity WebGL build is output, rebuilt with `tools/unity.sh build`
web/public/unity/

# Playwright output (screenshots for the gate check, reports, traces)
web/e2e/output/
web/test-results/
web/playwright-report/

# Raw archival downloads are fetched by the pipeline, never committed in bulk
data/raw/
data/work/

# Secrets
.env
.env.*
!.env.example

# NOTE: .kiro/ is part of the project and must never be ignored.

# Local assistant/editor settings, never part of the project
.claude/

# Parallel working copies for separate build lanes
.worktrees/
